<diagram xmlns="https://prefigure.org" 
  dimensions="(500,300)" 
  margins="(70,30,25,25)">
  <definition>f(x) = 64000 * 1.058^x</definition>
  <definition>points=(0,f(0)),(2,f(2)),(4,f(4)),(6,f(6)),(8,f(8)),(10,f(10))</definition>
  <coordinates bbox="(0,0,24,160000)">
    <grid-axes xlabel="Y" ylabel="F"
      hticks="(0,2,16)"
      vticks="(0,10000,160000)"
      hlabels="(0,2,16)"
      vlabels="(0,50000,150000)"
      spacings="((0,1,24),(0,10000,160000))"
      h-zero-label="yes"
      v-zero-label="yes"
    />
    <graph at="graph" function="f"/>
    <scatter points="points" />
    <point p="(7, 95000)" style="box" alignment="nw">
      Guess part d
    </point>
    <point p="(15,150000)" style="box" alignment="nw">
      Guess part e
    </point>
    <label anchor="(7,0)" alignment="south">
      <m>7</m>
    </label>
    <label anchor="(15,0)" alignment="south">
      <m>15</m>
    </label>
    <line endpoints="((15,150000), (15,0))" dash="4 4"/>
    <line endpoints="((15,150000), (0,150000))" dash="4 4"/>
    <line endpoints="((0,95000), (7,95000))" dash="4 4" />
    <line endpoints="((7,0), (7,95000))" dash="4 4" />
  </coordinates>
</diagram>