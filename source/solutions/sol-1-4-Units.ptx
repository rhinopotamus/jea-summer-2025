<exercises xml:id="sol-1-4-Units" xmlns:xi="http://www.w3.org/2001/XInclude">
	<xi:include href="ex-intro.ptx" />

<page>
	<exercise xml:id="sol-compare-lengths-units">
		<task>
			<introduction>
				<p>
					Compare centimeters (cm) and inches, using that 1 inch <m>\approx</m> 2.54 cm.
				</p>
			</introduction>
			<task>
				<statement>
					<p>
						Which is longer: 1 inch or 1 centimeter?
					</p>
				</statement>
				<solution>
					<p>
						1 inch is longer, because it takes like <m>2 \tfrac{1}{2}</m> cm to make 1 inch.
					</p>
				</solution>
			</task>
			<task>
				<statement>
					<p>
						Kamari is shopping at an internationally-based retail store. She is looking at a curtain rod that projects 10 cm from the wall. What is that in inches?
					</p>
				</statement>
				<solution>
					<p>
						<aside>
							<p>
								Set up unit conversion fractions so that units cancel, and divide by numbers on bottom.
							</p>
						</aside>
						<md>
							10\cancel{\text{ cm}} \ast \frac{1\text{ inch}}{2.54\cancel{\text{ cm}}} = \frac{10}{2.54} = 3.93\ldots \approx 4 \text{ inches}
						</md>
						Sense check: 4 of the larger unit = 10 of the smaller unit? Ok, sure!
					</p>
				</solution>
			</task>
			<task>
				<statement>
					<p>
						She also wants a basket no more than 1 foot wide or long to fit on her bookcase. How many centimeters are in a foot?
					</p>
				</statement>
				<solution>
					<p>
						<aside>
							<p>
								Don't know or forget a common conversion? Search online or ask someone!
							</p>
						</aside>
						<md>
							1\ \cancel{\text{foot}} \ast 
							\frac{12\ \cancel{\text{inches}}}{1\ \cancel{\text{foot}}}\ast
							\frac{2.54\ \text{cm}}{1\ \cancel{\text{inch}}}
							= \frac{1\cdot 12 \cdot 2.54}{1\cdot 1} = 30.48 \approx 30\ \text{cm}
						</md>
					</p>
				</solution>
			</task>
		</task>
		<task>
			<introduction>
				<p>
					Compare meters (m) and yards using that 1 yard <m>\approx</m> 0.9144 m.
				</p>
			</introduction>
			<task>
				<statement>
					<p>
						Which is longer: 1 yard or 1 meter?
					</p>
				</statement>
				<solution>
					<p>
						1 meter is longer, since 1 yard is about 91% of a meter <mdash /> not quite 100%.
					</p>
				</solution>
			</task>
			<task>
				<statement>
					<p>
						Princeton was watching the Olympics and noticed everything was measured in meters. He is curious how long a football field (100 yards) is in meters.
					</p>
				</statement>
				<solution>
					<p>
						<md>
							100\ \cancel{\text{yards}} \ast
							\frac{0.9144\ \text{meters}}{1\ \cancel{\text{yards}}}
							=100 \cdot 0.9144 = 91.44 \approx 91.44\ \text{meters}
						</md>
						
					</p>
				</solution>
			</task>
			<task>
				<statement>
					<p>
						Kamari found a really big bath towel she likes. 
						It is 1 meter wide and 1.5 meters long. 
						What are the dimensions in inches? Use that 1 yard = 3 feet.
					</p>
				</statement>
				<solution>
					<p>
						<md>
							1\ \cancel{\text{m}} \ast
							\frac{1\ \cancel{\text{yard}}}{0.9144\ \cancel{\text{m}}} \ast
							\frac{3\ \cancel{\text{feet}}}{1\ \cancel{\text{yard}}} \ast
							\frac{12\ \text{inches}}{1\ \cancel{\text{foot}}} =
							\frac{1\cdot 1 \cdot 3 \cdot 12}{0.9144 \cdot 1 \cdot 1}
							= \frac{36}{0.9144} = 39.37\ldots \approx 39\text{ inches}
						</md>
						
					</p>
					<p>
						<md>
							1.5\ \cancel{\text{m}} \ast
							\frac{1\ \cancel{\text{yard}}}{0.9144\ \cancel{\text{m}}} \ast
							\frac{3\ \cancel{\text{feet}}}{1\ \cancel{\text{yard}}} \ast
							\frac{12\ \text{inches}}{1\ \cancel{\text{foot}}} =
							\frac{1.5\cdot 1 \cdot 3 \cdot 12}{0.9144 \cdot 1 \cdot 1}
							= \frac{54}{0.9144} = 59.05\ldots \approx 59\text{ inches}
						</md>
						
					</p>
				</solution>
			</task>
		</task>
		<task>
			<introduction>
				<p>
					Compare kilometers (km) and miles using that 1 mile <m>\approx</m> 1.609 km. 
					
				</p>
			</introduction>
			<task>
				<statement>
					<p>
						Which is longer: 1 mile or 1 kilometer?
					</p>
				</statement>
				<solution>
					<p>
						1 mile is longer, since it takes more than 1 km to make 1 mile.
					</p>
				</solution>
			</task>
			<task>
				<statement>
					<p>
						This weekend Princeton and Kamari are doing a 5K run. How many miles long is that? Note: <term>5K</term> is short for 5 kilometers.
					</p>
				</statement>
				<solution>
					<p>
						<md>
							5\ \cancel{\text{km}} \ast
							\frac{1\ \text{mile}}{1.609\ \cancel{\text{km}}}
							= \frac{5}{1.609} = 3.107\ldots \approx 3.1 \text{ miles}
						</md>
						
					</p>
				</solution>
			</task>
			<task>
				<statement>
					<p>
						Princeton is actually in training for a marathon. How many kilometers is that? Note: a <term>marathon</term> is approximately 26.2 miles.
					</p>
				</statement>
				<solution>
					<p>
						<md>
							26.2\ \cancel{\text{miles}} \ast
							\frac{1.609\ \text{km}}{1\ \cancel{\text{mile}}}
							= 26.2 \cdot 1.609 = 42.15\ldots
							\approx 42\ \text{km}
						</md>
						
					</p>
				</solution>
			</task>
		</task>
	</exercise>
</page>

<page>
	<exercise xml:id="sol-decimal-hours-lengths-units">
		<task>
			<statement>
				<p>
					Yesterday Cameron worked for 2 hours and 15 minutes (that's 2:15) and then went home and studied for 7 hours and 57 minutes (that's 7:57). 
					<aside>
						<p>
							Hint: 7 hours and 57 minutes is not the same as 7.57 hours!
						</p>
					</aside>
					Convert each time into decimal hours.
				</p>
			</statement>
			<solution>
				<p>
					<aside>
						<p>
							General strategy: take the not-full-hours part and change it to the other format.
						</p>
					</aside>
					Work: Let's take the 15 minutes and convert it into hours. Since 15 minutes is less than one hour, I'm expecting to get a decimal that's less than 1.
					<md>
						15\ \cancel{\text{min}} \ast \frac{1\ \text{hour}}{60\ \cancel{\text{min}}} = \frac{15}{60} = 0.25\ \text{hour}
					</md>
					So Cameron worked for 2 hours + 0.25 hours = 2.25 hours.
				</p>
				<p>
					Study: Let's take the 57 minutes and convert it into hours.
					<aside>
						<p>
							Sense check: since 57 minutes is <em>almost</em> a full hour, it makes sense that our decimal is <em>almost</em> 1.
						</p>
					</aside>
					<md>
						57\ \cancel{\text{min}} \ast \frac{1\ \text{hour}}{60\ \cancel{\text{min}}} = \frac{57}{60} = 0.95\ \text{hour}
					</md>
					So Cameron worked for 7 hours + 0.95 hours = 7.95 hours.
					
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					Ephraim works at a plant that produces very delicate electronic switches. 
					He measured the lifetime for one switch at 4.18 hours. 
					Another had lifetime 19.75 hours. Convert each time into hours and minutes. 
					<em>That means H:MM format.</em>
				</p>
			</statement>
			<solution>
				<p>
					<aside>
						<p>
							Same general strategy: take the not-full-hours part and change it to the other format.
						</p>
					</aside>
					For the 4.18 hour switch, let's take the 0.18 hours and convert to minutes:
					<md>
						0.18\ \cancel{\text{hr}} \ast \frac{60\ \text{min}}{1\ \cancel{\text{hr}}} = 0.18 \cdot 60 = 10.8 \approx 11\ \text{min}
					</md>
					So, 4.18 hours is the same as 4 hours and 11 minutes, or 4:11.
				</p>
				<p>
					For the 19.75 hour switch:
					<md>
						0.75\ \cancel{\text{hr}} \ast \frac{60\ \text{min}}{1\ \cancel{\text{hr}}} = 0.75 \cdot 60 = 45\ \text{min}
					</md>
					So, 19.75 hours is the same as 19 hours and 45 minutes, or 19:45.
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					Phillip measured his office using a digital measure. 
					One wall is 21.8 feet. The other is 10.2 feet. 
					How long is each wall measured in the more usual feet and inches?
				</p>
			</statement>
			<solution>
				<p>
					<aside>
						<p>
							Notice that 0.8 feet is not the same as 8 inches, because feet are based on 12 inches rather than 10 inches!
						</p>
					</aside>
					For 21.8 feet:
					<md>
						0.8\ \cancel{\text{ft}} \ast \frac{12\ \text{in}}{1\ \cancel{\text{ft}}} = 0.8 \ast 12 = 9.6 \approx 10\ \text{in}
					</md>
					So 21.8 feet is the same as 21 feet and 10 inches, or 21<prime/>10<dblprime/>.
				</p>
				<p>
					For 10.2 feet:
					<md>
						0.2\ \cancel{\text{ft}} \ast \frac{12\ \text{in}}{1\ \cancel{\text{ft}}} = 0.2 \ast 12 = 2.4 \approx 2\ \text{in}
					</md>
					So 10.2 feet is the same as 10 feet and 2 inches, or 10<prime/>2<dblprime/>.
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					The couch Stetson wanted to buy is 92<dblprime/> long and 44<dblprime/> tall. 
					Convert the length and height to feet and inches.
				</p>
			</statement>
			<solution>
				<p>
					<md>
						<mrow>
							92\ \cancel{\text{in}} \amp\ast \frac{1\ \text{ft}}{12\ \cancel{\text{in}}} = \frac{92}{12} = 7.66 \ldots\ \text{ft}
						</mrow>
						<mrow>
							0.66 \ldots \ \cancel{\text{ft}}\amp\ast \frac{12\ \text{in}}{1\ \cancel{\text{ft}}} = 0.66\ldots \cdot 12 = 8\ \text{in}
						</mrow>
					</md>
					So 92<dblprime /> is the same as 7<prime/>8<dblprime/>.
				</p>
				<p>
					<md>
						<mrow>
							44\ \cancel{\text{in}} \amp\ast \frac{1\ \text{ft}}{12\ \cancel{\text{in}}} = \frac{44}{12} = 3.66 \ldots\ \text{ft}
						</mrow>
						<mrow>
							0.66 \ldots \ \cancel{\text{ft}}\amp\ast \frac{12\ \text{in}}{1\ \cancel{\text{ft}}} = 0.66\ldots \cdot 12 = 8\ \text{in}
						</mrow>
					</md>
					So 44<dblprime /> is the same as 3<prime/>8<dblprime/>.
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					Abdi volunteers at a food bank. He noticed that the shelf on the back wall 
					was bending so he measured its length at 12<prime/>5<dblprime/>. 
					The formula for load needs the length written as a decimal. 
					Convert the length to a decimal number of feet.
				</p>
			</statement>
			<solution>
				<p>Let's convert the 5 inches to feet:
					<md>
						5\ \cancel{\text{in}} \ast \frac{1\ \text{ft}}{12\ \cancel{\text{in}}} = \frac{5}{12} = 0.416\ldots \approx 0.4\ \text{ft}
					</md>
					So 12<prime/>5<dblprime/> is (approximately) the same as 12.4 ft.
				</p>
			</solution>
		</task>
	</exercise>
</page>

<page>
	<exercise xml:id="sol-drink-water-units">
		<introduction>
			<p>
				Some people say we should drink 8 glasses of water (or other liquids) every day, 
				where a glass is defined as 8 (liquid) ounces.
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					Ingrid uses a 20 ounce unbreakable plastic bottle. 
					How many of those bottles full of water does she need to drink each day?
				</p>
			</statement>
			<solution>
				<p>
					Here are some math sentences from the story that we can use to help us set up unit conversion fractions:
					<aside>
						<p>
							The abbreviation <q>oz</q> is short for <q>ounces</q>.
						</p>
					</aside>
					<md>
						<mrow>1\ \text{day} \amp= 8\ \text{glasses} </mrow>
						<mrow>1\ \text{glass} \amp= 8\ \text{oz} </mrow>
						<mrow>1\ \text{bottle} \amp= 20\ \text{oz}</mrow>
					</md>
					Let's use these to convert from 1 day to ounces:
					<md>
						1\ \cancel{\text{day}} \ast 
						\frac{8\ \cancel{\text{glasses}}}{1\ \cancel{\text{day}}} \ast
						\frac{8\ \cancel{\text{oz}}}{1\ \cancel{\text{glass}}} \ast
						\frac{1\ \text{bottle}}{20\ \cancel{\text{oz}}} =
						\frac{1 \cdot 8 \cdot 8 \cdot 1}{1 \cdot 1 \cdot 20} = 3.2
					</md>
					So Ingrid should drink 3.2 bottles every day. But 0.2 of a bottle is silly; let's round up to 4 bottles because it's probably better to drink more water than less.
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					Siri carries around a insulated water bottle that holds 0.6 liters. 
					How many of those bottles full of water does she need to drink each day?
					Use that 1 liter <m>\approx</m> 1.057 quarts and 1 quart = 32 (liquid) ounces.
				</p>
			</statement>
			<solution>
				<p>
					This time, 1 bottle = 0.6 liters instead of 1 bottle = 20 oz.
					<md>
						1\ \cancel{\text{day}} \ast 
						\frac{8\ \cancel{\text{glasses}}}{1\ \cancel{\text{day}}} \ast
						\frac{8\ \cancel{\text{oz}}}{1\ \cancel{\text{glass}}} \ast
						\frac{1\ \cancel{\text{qt}}}{32\ \cancel{\text{oz}}} \ast
						\frac{1\ \cancel{\text{liter}}}{1.057\ \cancel{\text{qt}}}
						\frac{1\ \text{bottle}}{0.6\ \cancel{\text{liters}}} =
						\frac{1 \cdot 8 \cdot 8 \cdot 1\cdot 1}{1 \cdot 1 \cdot 32 \cdot 1.057\cdot 0.6} = 3.153\ldots
					</md>
					Rounding up again, Siri should also drink 4 bottles of water every day.
					<aside>
						<p>
							To see why these numbers came out about the same, try converting 20 ounces into liters!
						</p>
					</aside>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					To meet the recommendation, how much water would one person drink in an entire year? 
					Give the answer in gallons. Use 1 gallon = 4 quarts.
				</p>
			</statement>
			<solution>
				<p>
					<md>
						<mrow>
							1\ \cancel{\text{year}} \amp\ast
							\frac{365\ \cancel{\text{days}}}{1\ \cancel{\text{year}}} \ast
							\frac{8\ \cancel{\text{glasses}}}{1\ \cancel{\text{day}}} \ast
							\frac{8\ \cancel{\text{oz}}}{1\ \cancel{\text{glass}}} \ast
							\frac{1\ \cancel{\text{qt}}}{32\ \cancel{\text{oz}}}\ast
							\frac{1\ \text{gallon}}{4\ \cancel{\text{qt}}}
						</mrow>
						<mrow> \amp= \frac{1\cdot 365\cdot 8 \cdot 8 \cdot 1 \cdot 1}{1 \cdot 1 \cdot 1 \cdot 32 \cdot 4} = 182.5\ \text{gallons} </mrow>
					</md>
					
				</p>
			</solution>
		</task>
	</exercise>
</page>

<page>
	<exercise xml:id="sol-finland-units">
		<introduction>
			<p>
				Jenna is studying in Finland this term and rented an older car to drive.
			</p>
		</introduction>
		<task>
			<statement>
				<p>
					She learns that no matter what the road signs might say, 
					the maximum speed limit in Finland in winter is never more than 100 km/hr. 
					How fast is that in miles per hour (mph)? 
					Use 1 mile <m>\approx</m> 1.609 km.
				</p>
			</statement>
			<solution>
				<p>
					<md>
						\frac{100\ \cancel{\text{km}}}{1\ \text{hr}} \ast
						\frac{1\ \text{mile}}{1.609\ \cancel{\text{km}}}
						= \frac{100\cdot 1}{1\cdot 1.609} = 62.15\ldots \approx 62\ \text{mph}
					</md>
					
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					Jenna's car holds 62 liters of gasoline in its tank. How many gallons is that? 
					Use 1 liter <m>\approx</m> 1.057 quarts and 1 gallon = 4 quarts.
				</p>
				<aside>
					<p>
						We often use the letter <q>l</q> as an abbreviation for <q>liters</q>, but since that looks a lot like a number 1 in handwriting, we usually write it curly: <q><m>\ell</m></q>
					</p>
				</aside>
			</statement>
			<solution>
				<p>
					<md>
						62\ \cancel{\ell} \ast
						\frac{1.057\ \cancel{\text{qt}}}{1\ \cancel{\ell}} \ast
						\frac{1\ \text{gallon}}{4\ \cancel{\text{qt}}} = 
						\frac{62 \cdot 1.057 \cdot 1}{1\cdot 4} = 
						16.38 \ldots \approx 16.4\ \text{gallons}
					</md>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					Her car gets 7.6 km/liter. Convert to miles per gallon (mpg).
				</p>
			</statement>
			<solution>
				<p>
					<md>
						\frac{7.6\ \cancel{\text{km}}}{1\ \cancel\ell} \ast
						\frac{1\ \text{mile}}{1.609\ \cancel{\text{km}}} \ast
						\frac{1\ \cancel\ell}{1.057\ \cancel{\text{qt}}} \ast
						\frac{4\ \cancel{\text{qt}}}{1\ \text{gallon}}= 
						\frac{7.6\cdot 1 \cdot 1 \cdot 4}{1 \cdot 1.609 \cdot 1.057 \cdot 1}
						= 17.87\ldots \approx 17.9\ \text{mpg}
					</md>
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					Gas prices in Finland were 1.658 €/liter. 
					What's the equivalent price in $/gal? 
					The symbol € stands for euro. Use 1 € <m>\approx</m> $1.23.
				</p>
			</statement>
			<solution>
				<p>
					<md>
						\frac{1.658\ \cancel{\text{€}} }{1\ \cancel\ell} \ast
						\frac{\$1.23}{1\ \cancel{\text{€}}} \ast
						\frac{1\ \cancel\ell}{1.057\ \cancel{\text{qt}}} \ast
						\frac{4\ \cancel{\text{qt}}}{1\ \text{gallon}}= 
						\frac{1.658 \cdot 1.23 \cdot 1 \cdot 4}{1\cdot 1 \cdot 1.057 \cdot 1} =
						7.717\ldots \approx \$7.72 / \text{gal (Wow!)}
					</md>
					
				</p>
			</solution>
		</task>
		<task>
			<statement>
				<p>
					What would it cost Jenna, in euros, for a full tank of gas? 
					How much is that in dollars? 
				</p>
			</statement>
			<solution>
				<p>
					From previous parts of this problem, we know some math sentences:
					<md>
						<mrow>1\ \text{tank} \amp= 62\ \ell </mrow>
						<mrow>1\ \ell \amp= 1.658\ \text{€}</mrow>
						<mrow>1\ \text{€} \amp= 1.23\ \$ </mrow>
					</md>
					Let's put all these together:
					<md>
						1\ \cancel{\text{tank}} \ast
						\frac{62\ \cancel{\ell}}{1\ \cancel{\text{tank}}} \ast
						\frac{1.658\ \text{€}}{1\ \cancel{\ell}} = \frac{1\cdot 62 \cdot 1.658}{1\cdot 1} = 102.79 \approx 103\ \text{€}
					</md>
					And now we'll convert that to dollars:
					<md>
						102.79\ \cancel{\text{€}} \ast
						\frac{\$ 1.23}{1\ \cancel{\text{€}}} = 102.79\cdot 1.23 
						= 126.43\ldots \approx \$ 126
					</md>
					
				</p>
			</solution>
		</task>
	</exercise>
</page>

	

	<exercise xml:id="sol-phelps-units" component="not-workbook">
		<introduction>
			<p>
				In August 2008, 
				<aside>
					<p>
						Source: Wikipedia (World record progression 200 metres IM)
					</p>
				</aside>
				United States swimmer Michael Phelps set the world record for the 200 meter individual medley, swimming it in 1 minute, 54.80 seconds.
			</p>
		</introduction>
			<task>
				<statement>
					<p>
						Convert Phelps's time into minutes.
					</p>
				</statement>
			</task>
			
			<task>
				<statement>
					<p>
						How fast did Phelps swim, as measured in meters/min?
					</p>
				</statement>
			</task>
			
			<task>
				<statement>
					<p>
						Convert Phelps's speed to mph. Use <m>1 \text{ mile} \approx {1{,}609} \text{ meters}</m>.
					</p>
				</statement>
			</task>
	</exercise>
			
	<exercise xml:id="sol-lochte-units" component="not-workbook">
		<introduction>
			<p>
				In August 2012, Phelps improved his time and won Olympic gold, but failed to break the world record his teammate Ryan Lochte had set a year earlier of 1 minute, 54 seconds.
			</p>
		</introduction>

			<task>
				<statement>
					<p>
						Convert Lochte's time into minutes.
					</p>
				</statement>
			</task>
			
			<task>
				<statement>
					<p>
						How fast did Lochte swim, as measured in meters/min?
					</p>
				</statement>
			</task>
			
			<task>
				<statement>
					<p>
						Convert Lochte's speed to mph.
					</p>
				</statement>
			</task>
	</exercise>

	<exercise xml:id="sol-assorted-1-units" component="not-workbook">
		<task>
			<statement>
				<p>
					The typical weight limit for a suitcase on flights within Africa is 20 kg. How many pounds is that? Use <m>1 \text{ kilogram} \approx 2.2 \text{ pounds}</m>.
				</p>
			</statement>
		</task>
		
		<task>
			<statement>
				<p>
					How many servings are in a 20 ounce package of cookies where a serving size is 3 cookies and each cookie weighs 11 grams? Use <m>1 \text{ ounce} = 28.3 \text{ grams}</m>.
				</p>
			</statement>
		</task>
		
		<task>
			<statement>
				<p>
					My corner convenience store sells a <q>thirst quencher</q> size of soft drink; it holds 64 (fluid) ounces. If a can of soft drink is 12 (fluid) ounces, how many cans are in the <q>thirst quencher</q>?
				</p>
			</statement>
		</task>
	</exercise>

	<exercise xml:id="sol-assorted-2-units" component="not-workbook">
		<task>
			<statement>
				<p>
					The football coach wants everyone to sprint three-quarters of a mile, up and back on the field which is labeled in yards. 
					<aside>
						<p>
							(Story also appears in <xref ref="football-field-fractions"/>)
						</p>
					</aside>
					How many yards are in three-quarters of a mile?
				</p>
			</statement>
		</task>
		
		<task>
			<statement>
				<p>
					The quilt pattern calls for 0.375 yards of calico fabric. How many feet is 0.375 yards?
				</p>
			</statement>
		</task>
		
		<task>
			<statement>
				<p>
					The website said that basil plants should be 0.35 feet tall a month after germinating. How many inches is 0.35 feet?
				</p>
			</statement>
		</task>
	</exercise>

	<exercise xml:id="sol-pollution-spill-units" component="not-workbook">
		<introduction>
			<p>
				Authorities are tracking down the source of a pollution spill on a nearby river. They suspect that the local plant is inadvertently leaking waste water. Last week they found 35 minutes of waste water flow on Monday, 1 hour and 11 minutes on Tuesday, 1/4 hour on Wednesday (that's 0.25 hours in decimal), none on Thursday, and then 98 minutes Friday.
			</p>
		</introduction>	
		<task>
			<statement>
				<p>
					Convert units as needed to complete the following table showing each time in minutes, each time in hours, and each time in hours and minutes (H:MM format).
				</p>
					
				<p>
					<em>Hint: 15 minutes in H:MM format would be 0:15</em>
				</p>
					
				<tabular bottom="minor" top="minor">
					<row left="minor" header="yes">
						<cell right="minor" halign="left">Day</cell>
						<cell right="minor" halign="center">Mon</cell>
						<cell right="minor" halign="center">Tue</cell>
						<cell right="minor" halign="center">Wed</cell>
						<cell right="minor" halign="center">Thu</cell>
						<cell right="minor" halign="center">Fri</cell>
					</row>
					<row left="minor">
						<cell right="minor" halign="left">Minutes</cell>
						<cell right="minor" halign="center">35</cell>
						<cell right="minor" halign="center"><m><fillin fill="\displaystyle\int\int" /></m></cell>
						<cell right="minor" halign="center"><m><fillin fill="\displaystyle\int\int" /></m></cell>
						<cell right="minor" halign="center">0</cell>
						<cell right="minor" halign="center">98</cell>
					</row>
					<row left="minor">
						<cell right="minor" halign="left">Hours</cell>
						<cell right="minor" halign="center"><m><fillin fill="\displaystyle\int\int" /></m></cell>
						<cell right="minor" halign="center"><m><fillin fill="\displaystyle\int\int" /></m></cell>
						<cell right="minor" halign="center">0.25</cell>
						<cell right="minor" halign="center"><m><fillin fill="\displaystyle\int\int" /></m></cell>
						<cell right="minor" halign="center"><m><fillin fill="\displaystyle\int\int" /></m></cell>
					</row>
					<row left="minor">
						<cell right="minor" halign="left">H:MM</cell>
						<cell right="minor" halign="center"><m><fillin fill="\displaystyle\int\int" /></m></cell>
						<cell right="minor" halign="center">1:11</cell>
						<cell right="minor" halign="center"><m><fillin fill="\displaystyle\int\int" /></m></cell>
						<cell right="minor" halign="center"><m><fillin fill="\displaystyle\int\int" /></m></cell>
						<cell right="minor" halign="center"><m><fillin fill="\displaystyle\int\int" /></m></cell>
					</row>
				</tabular>
			</statement>
		</task>
		
		<task>
			<statement>
				<p>
					Calculate the total waste water flow measured last week.
				</p>
			</statement>
		</task>
	</exercise>

	<exercise xml:id="sol-heart-beats-units" component="not-workbook">
		<statement>
			<p>
				If your heart beats around 70 times a minute, how many times does it beat in a week? A year?
			</p>
		</statement>	
	</exercise>

	<exercise xml:id="sol-assorted-3-units" component="not-workbook">
		<task>
			<statement>
				<p>
					Harold's Physics textbook says an object is thrown into the air at 36 feet per second. To understand how fast that is, convert to mph.
				</p>
			</statement>
		</task>
		
		<task>
			<statement>
				<p>
					Harold's History textbook mentions that in 1800 the city encompassed about 6,000 acres. How many square miles is that? Use <m>1 \text{ square mile} = 640 \text{ acres}</m>.
				</p>
			</statement>
		</task>
		
		<task>
			<statement>
				<p>
					Harold's Economics textbooks lists the recent high price of crude oil at $100 per barrel. He'd like to know what that means in $/gallon of gasoline. It turns out that 1 barrel of crude oil produces about 19.4 gallons of gasoline.
				</p>
			</statement>
		</task>
	</exercise>
</exercises>
