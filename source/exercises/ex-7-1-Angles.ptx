<exercise xml:id="find-missing-angle-angles">
    <introduction>
        <p>
            Find the missing angle in each triangle.
        </p>
    </introduction>
    <task>
        <statement>
            <p>
                What is the center angle <m>\alpha</m> on the roof of a Tudor house?
            </p>
            <image width="60%">
                <latex-image xml:id="tikz-7-1-ex-1-a">
                \begin{tikzpicture}[scale=1]
                    % Coordinates
                    \coordinate (A) at (0, 0);
                    \coordinate (B) at (6, 0);
                    % Height h = 3 * tan(40°) ≈ 2.517
                    \coordinate (C) at (3, 2.517);

                    % Draw Roof Triangle
                    \draw[thick] (A) -- (B) -- (C) -- cycle;

                    % Bottom-left angle arc and label (40°)
                    \draw (0.8,0) arc (0:40:0.8);
                    \node at (1.15, 0.3) {$40^\circ$};

                    % Bottom-right angle arc and label (40°)
                    \draw (5.2,0) arc (180:140:0.8);
                    \node at (4.85, 0.3) {$40^\circ$};

                    % Top angle arc (unlabeled)
                    \draw (2.74, 2.3) arc (220:320:0.34);
                    \node at (3,1.9) {$\alpha$};
                    \end{tikzpicture}
                </latex-image>
            </image>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                What is the center angle <m>\beta</m> on the roof of a Gothic Revival house? 
            </p>
            <image width="60%">
                <latex-image xml:id="tikz-7-1-ex-1-b">
                \begin{tikzpicture}
                    % Coordinates
                    \coordinate (A) at (0, 0);
                    \coordinate (B) at (6, 0);
                    % Height h = 3 * tan(53°) ≈ 3.981
                    \coordinate (C) at (3, 3.981);

                    % Draw Roof Triangle
                    \draw[thick] (A) -- (B) -- (C) -- cycle;

                    % Bottom-left angle arc and label (53°)
                    \draw (0.8,0) arc (0:53:0.8);
                    \node at (1.1, 0.4) {$53^\circ$};

                    % Bottom-right angle arc and label (53°)
                    \draw (5.2,0) arc (180:127:0.8);
                    \node at (4.9, 0.4) {$53^\circ$};

                    % Top angle arc (unlabeled)
                    \draw (2.73, 3.62) arc (233:307:0.45);
                    \node at (3,3.3) {$\beta$};
                \end{tikzpicture}
                </latex-image>
            </image>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                Marta is hanging a banner for Coach Pelto. The 16-foot ladder makes an angle of approximately 75.5<degree /> with the floor. What angle <m>\theta</m> does the ladder make with the wall?
            </p>

            <aside>
                <p>
                    Story appears in 6.2
                </p>
            </aside>

            <image width="30%">
                <latex-image>
                \begin{tikzpicture}[line width=1.5pt, scale = .5]
                    % The triangle
                    \draw (0,0) -- (4,0);
                    \draw (4,0) -- (4,15.491);
                    \draw (0,0) -- (4,15.491);

                    % Labels
                    \node at (2, -1) {floor};
                    \node at (0.25, 7) {ladder};
                    \node at (5.5, 7) {wall};

                    % Box indicating perpendicular
                    \draw (3,1) -- (4,1);
                    \draw (3,0) -- (3,1);

                    % Bottom-left angle arc and label (14.5°)
                    \draw (1.4, 0) arc (0:75.5:1.4);
                    \node at (2, 1.5) {$75.5^\circ$};

                    % Top angle arc and label (B)
                    \draw (4, 13) arc (270:255.5:2.15);
                    \node at (3.5, 12) {$\theta$};
                \end{tikzpicture}
                </latex-image>
            </image>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                An ADA accessible ramp is 48 feet long and rises 4 feet from the sidewalk to the entrance to the women's health clinic. If the ramp makes an angle of approximately <m>4.78^{\circ}</m> with the ground, at what angle <m>\phi</m> does the ramp meet the entrance?
            </p>

            <aside>
                <p>Story also appears in 6.2</p>
            </aside>

            <image>
                <latex-image xml:id="tikz-7-2-ex-1-d">
                \begin{tikzpicture}[line width=1.5pt, scale=0.22]
                    % Coordinates: width ≈ 47.83 ft, height = 4 ft
                    \coordinate (A) at (0, 0);
                    \coordinate (B) at (47.833, 0);
                    \coordinate (C_coord) at (47.833, 4);

                    % Draw Triangle
                    \draw (A) -- (B) -- (C_coord) -- cycle;

                    % Right angle indicator square at (B), scaled down to 2/3 size
                    \pgfmathsetmacro{\sqSize}{2 * 2/3}
                    \pgfmathsetmacro{\cornerX}{47.833 - \sqSize}
                    \draw (\cornerX, 0) -- (\cornerX, \sqSize) -- (47.833, \sqSize);

                    % Side Labels
                    \node[below] at (23.916, 0) {ground};
                    \node[right] at (48.333, 2) {4 feet};
                    \node[above left, sloped, anchor=south, yshift=2mm] at (23.916, 2) {ramp (48 feet)};

                    % Angle at bottom-left arc
                    \draw (8, 0) arc (0:4.78:8);

                    % (1) 4.78° moved closer (x=-2, y=2.2) and arrow re-aimed to arc
                    \node (angleLabel) at (4, 4) {$4.78^\circ$};
                    \draw[-&gt;, thin] (angleLabel.south) -- (7, 1);

                    % Angle arc at top vertex C
                    \draw (47.833, 2) arc (270:200.22:2.5);
                    % (2) Label C moved higher (y=2.6) while keeping it under the arc
                    \node[below left] at (46.0, 3.6) {$\phi$};
                \end{tikzpicture}
                </latex-image>
            </image>
        </statement>
    </task>
</exercise>

<exercise xml:id="skateboard-angles">
    <introduction>
        <p>
            Valeria is just learning to skateboard. She is trying to do a full 360<degree/> but she's not quite there yet. Draw each angle Valeria was able to land in standard position.
        </p>
    </introduction> 
    <task>
        <statement>
            <p>
                80<degree/>
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                150<degree/>
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                225<degree/> (Hint: <m>225 = 180 + 45</m>)
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                300<degree/> (So close!)
            </p>
        </statement>
    </task>
</exercise>

<exercise xml:id="linden-branch-angles">
    <introduction>
        <p>
            The 45<m>^{\circ}</m> of the linden tree branch also sits within a right triangle. If we measure <m>a=1</m> foot vertically up the tree and then <m>b</m> feet out horizontally to meet the branch, of length <m>c</m> feet, then we get this triangle.
        </p>

        <image width="60%">
            <latex-image xml:id="tikz-7-1-ex-3">
            \begin{tikzpicture}[scale=1]
                % Coordinates
                \coordinate (A) at (0, 3); % Right-angle corner (top-left)
                \coordinate (B) at (0, 0); % Bottom corner
                \coordinate (C) at (3, 3); % Top-right corner

                % Draw Triangle with hypotenuse label attached
                \draw[thick] (A) -- (C) -- (B) node[midway, sloped, below] {branch ($c \text{ feet}$)} -- cycle;

                % Right angle symbol
                \draw (0, 2.8) -- (0.2, 2.8) -- (0.2, 3);

                % Bottom 45° angle arc and label
                \draw (0, 0.5) arc (90:45:0.5);
                \node at (0.35, 0.75) {$45^\circ$};

                % Top-right 45° angle arc and label
                \draw (2.5, 3) arc (180:225:0.5);
                \node at (2.25, 2.65) {$\alpha$};

                % Side Labels
                \node[left] at (0, 1.5) {($a = 1\text{ foot}$)};
                \node[left] at (-.2, 2) {tree trunk};
                \node[above] at (1.5, 3) {$b \text{ feet}$};
            \end{tikzpicture}
            </latex-image>
        </image>
    </introduction>
    <task>
        <statement>
            <p>
                Find the missing angle <m>\alpha</m>.
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                Use symmetry to explain why <m>b = 1</m> foot.
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                Use the Pythagorean Theorem to find <m>c</m>, the length of the branch. Give an exact answer (using square roots) and an approximation to three decimal places.
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                Redraw the triangle in a new position where one leg is horizontal at the bottom and the other leg is vertical on the right. Label each side with their length and use the exact square root value for the hypotenuse. Label the angles including drawing the small square at the right angle. This triangle is the <alert>isoceles right triangle</alert>.
            </p>
        </statement>
    </task>
</exercise>

<exercise xml:id="two-fifty-angles">
    <introduction>
        <p>
            Suba is tossing and turning.  Can't sleep!  She looks at the clock and it says 2:50 AM (and 20 seconds). Argh.  Suba wonders, what angle each of the clock hands has traveled since midnight when she went to bed?
        </p>
        <image width="60%">
            <latex-image xml:id="tikz-7-2-ex-4">
            \begin{tikzpicture}[scale=1]
                % Clock face outline
                \draw[thick] (0,0) circle (2);
                \fill (0,0) circle (0.06); % Center pin

                % Hour ticks and numbers
                \foreach \angle/\label in {
                    90/12, 60/1, 30/2, 0/3, 330/4, 300/5, 
                    270/6, 240/7, 210/8, 180/9, 150/10, 120/11
                } {
                    \draw[thick] (\angle:1.85) -- (\angle:2);
                    \node at (\angle:1.6) {\small\textbf{\label}};
                }

                % Minute ticks (smaller)
                \foreach \m in {0,6,...,354} {
                    \draw[line width=0.5pt] (\m:1.92) -- (\m:2);
                }

                % --- HAND CALCULATIONS ---
                % 2:50 and 20 seconds:
                % Hour hand angle = 90° - (2 + 50/60 + 20/3600) * 30° ≈ 4.83°
                % Minute hand angle = 90° - (50 + 20/60) * 6° = -212° = 148°
                % Second hand angle = 90° - (20 * 6°) = -30° = 330°

                % Hour hand (Short &amp; Very Thick with Arrowhead)
                \draw[-&gt;, &gt;=latex, line width=3.5pt, line cap=round] (0,0) -- (4.83:1.0);

                % Minute hand (Long &amp; Very Thick with Arrowhead)
                \draw[-&gt;, &gt;=latex, line width=3pt, line cap=round] (0,0) -- (148:1.6);

                % Second hand (Thin &amp; Red with Arrowhead)
                \draw[-&gt;, &gt;=latex, line width=1pt, red, line cap=round] (0,0) -- (330:1.75);
                \draw[line width=1pt, red] (0,0) -- (150:0.3); % Small tail
                \fill[red] (0,0) circle (0.04); % Red center cap
            \end{tikzpicture}
            </latex-image>
        </image>
        <p>
            All hands start pointing to 12 at midnight.  Notice the numbers 1, 2, <ellipsis/> 12 are placed equally around the circle.
        </p>
    </introduction>
    <task>
        <statement>
            <p>
                What is the angle between any two consecutive numbers on the clock (like between 12 and 1, or betweeen 2 and 3)?
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                The hour hand is the short thick arrow that points in between 2 and 3 (because it's almost 3 AM).  Approximately what angle has the hour hand traveled?  Hint: It moves from 12 to where it is.
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                The minute hand is the long thick arrow that points at 10 (because it's <m>10 \times 5 = 50</m> minutes past the hour). Approximately what angle has the minute hand traveled? Hint: It has made a full circle each hour (12-1, 1-2), plus the angle traveled from 12 to where it is now.
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                The second hand is the long thin arrow that points to 4 (because it's <m>4 \times 5 = 20</m> seconds past the hour). Approximately what angle has the second hand traveled? Hint: It has made a full circle each of the 170 minutes, plus the angle traveled from 12 to where it is now.
            </p>
        </statement>
    </task>
</exercise>

<exercise xml:id="sailboat-race-angles" component="not-workbook">
    <statement>
        <p>
            In a sailboat race, the boats must navigate around three buoys (floating markers) labeled A, B, and C, forming a triangular course on the bay. At buoy A, the angle between the line to B and the line to C measures 42<degree/>. At buoy B, the angle between the line to A and the line to C measures 68<degree/>. At buoy C, what is the angle between the line to A and the line to B?
        </p>
    </statement>
</exercise>

<exercise xml:id="wizard-spells-angles" component="not-workbook">
    <introduction>
        <p>
            In a fantasy video game, a wizard aims spells relative to the horizontal ground. That means, the positive <m>x</m>-axis is 0<degree/>.
        </p>
    </introduction>
    <task>
        <statement>
            <p>
                To cast a fire spell at a dragon flying in the sky, the wizard aims up at an angle of 115<degree/>. Draw this angle in standard position.
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                To cast an ice spell at a creature on the ground below, the wizard aims down at an angle of <m>-60^{\circ}</m>. Draw this angle in standard position.
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                If the wizard aims straight up into the air to launch a signal flare, what angle in standard position represents this direction?
            </p>
        </statement>
    </task>
</exercise>

<exercise xml:id="giant-swing-angles" component="not-workbook">
    <introduction>
        <p>
            At an amusement park, a giant swing ride starts facing directly east (along the positive <m>x</m>-axis, 0<degree />).
        </p>
    </introduction>
    <task>
        <statement>
            <p>
                During a thrill ride, the swing spins counterclockwise through 2 full rotations plus another 45<degree/>. What is the total angle of rotation in degrees? Draw this angle in standard position.
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                The swing returns to facing directly east. Then, the swing spins counterclockwise through a total angle of 810<degree/>. How many full rotations does the swing complete, and where does it end up pointing?
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                he swing returns to facing directly east. Then, the swing spins counterclockwise through a total angle of <m>-450^{\circ}</m> (which means it goes backwards <m>450^{\circ}</m>). Draw this angle in standard position.
            </p>
        </statement>
    </task>
</exercise>
</exercises>